<!DOCTYPE html>
<html>
<head>
  <title>SmsTrap</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <style>
    .sms-trap-shell {
      max-width: 480px;
      margin: 0 auto;
      padding: 24px 16px 64px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #1c1c1e;
    }

    .sms-trap-header {
      margin-bottom: 20px;
    }

    .sms-trap-header h1 {
      font-size: 22px;
      margin: 4px 0 0;
    }

    .sms-trap-subtitle {
      color: #8e8e93;
      font-size: 14px;
      margin: 0;
    }

    .sms-trap-back {
      color: #007aff;
      font-size: 14px;
      text-decoration: none;
    }

    .sms-trap-empty {
      color: #8e8e93;
      text-align: center;
      margin-top: 48px;
    }

    .sms-trap-conversation-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid #e5e5ea;
    }

    .sms-trap-conversation-card {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding: 14px 4px;
      border-bottom: 1px solid #e5e5ea;
      text-decoration: none;
      color: inherit;
    }

    .sms-trap-conversation-number {
      font-weight: 600;
      flex-shrink: 0;
    }

    .sms-trap-conversation-preview {
      color: #8e8e93;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      flex: 1;
    }

    .sms-trap-conversation-time {
      color: #8e8e93;
      font-size: 12px;
      flex-shrink: 0;
    }

    .sms-trap-phone {
      background: #f2f2f7;
      border-radius: 24px;
      padding: 16px;
    }

    .sms-trap-thread {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .sms-trap-bubble {
      max-width: 75%;
      padding: 10px 14px;
      border-radius: 18px;
      position: relative;
    }

    .sms-trap-bubble p {
      margin: 0;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .sms-trap-bubble time {
      display: block;
      font-size: 11px;
      margin-top: 4px;
      opacity: 0.7;
    }

    .sms-trap-bubble--outbound {
      align-self: flex-end;
      background: #007aff;
      color: #fff;
    }

    .sms-trap-bubble--inbound {
      align-self: flex-start;
      background: #e5e5ea;
      color: #1c1c1e;
    }
  </style>
</head>
<body>

<%= yield %>

</body>
</html>
